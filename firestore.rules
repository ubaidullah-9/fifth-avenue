rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
             (isSignedIn() && exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid))) ||
             (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'ubaidullah.bhatti99@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'description', 'category', 'image']) &&
             data.keys().hasOnly(['name', 'description', 'price', 'category', 'image', 'priceSmall', 'priceMedium', 'priceLarge']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             (!data.keys().hasAny(['price']) || (data.price is string && data.price.size() <= 20)) &&
             (!data.keys().hasAny(['priceSmall']) || (data.priceSmall is string && data.priceSmall.size() <= 20)) &&
             (!data.keys().hasAny(['priceMedium']) || (data.priceMedium is string && data.priceMedium.size() <= 20)) &&
             (!data.keys().hasAny(['priceLarge']) || (data.priceLarge is string && data.priceLarge.size() <= 20)) &&
             data.category is string && data.category.matches('^(pizza|burgers|shawarma|spin_roll|wings|fries|sides)$') &&
             data.image is string && data.image.size() <= 500;
    }

    function isValidDeal(data) {
      return data.keys().hasAll(['title', 'price', 'savings', 'items']) &&
             data.size() == 4 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.price is string && data.price.size() > 0 && data.price.size() <= 20 &&
             data.savings is string && data.savings.size() <= 20 &&
             data.items is list && data.items.size() <= 10 &&
             (data.items.size() == 0 || (data.items[0] is string && data.items[0].size() <= 100));
    }

    function isValidBusinessDetails(data) {
      return data.keys().hasAll(['name', 'branch', 'address', 'phone', 'hours']) &&
             data.size() == 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.branch is string && data.branch.size() <= 100 &&
             data.address is string && data.address.size() <= 200 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.hours is string && data.hours.size() <= 100;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email']) &&
             data.size() == 1 &&
             data.email is string && data.email.size() <= 200;
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(itemId) && isValidMenuItem(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidMenuItem(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'priceSmall', 'priceMedium', 'priceLarge', 'category', 'image']);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /deals/{dealId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(dealId) && isValidDeal(incoming());
      allow update: if isAdmin() && isValidId(dealId) && isValidDeal(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'savings', 'items']);
      allow delete: if isAdmin() && isValidId(dealId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(settingId) && isValidBusinessDetails(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidBusinessDetails(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'branch', 'address', 'phone', 'hours']);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow update: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /admin_profiles/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().keys().hasAll(['username', 'fullName', 'phone', 'designation', 'email', 'role', 'createdAt']);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}
