{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A pizza or side item on the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "enum": ["signature", "classic", "sides"] },
        "image": { "type": "string", "maxLength": 500 }
      },
      "required": ["name", "description", "price", "category", "image"]
    },
    "Deal": {
      "title": "Deal",
      "description": "A special offer",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 20 },
        "savings": { "type": "string", "maxLength": 20 },
        "items": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxLength": 10 }
      },
      "required": ["title", "price", "savings", "items"]
    },
    "BusinessDetails": {
      "title": "BusinessDetails",
      "description": "Global settings for the business",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "branch": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 20 },
        "hours": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "branch", "address", "phone", "hours"]
    },
    "Admin": {
      "title": "Admin",
      "description": "An admin user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "menuItems/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items"
    },
    "deals/{dealId}": {
      "schema": { "$ref": "#/entities/Deal" },
      "description": "Deals"
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessDetails" },
      "description": "Business settings, e.g. document id 'businessDetails'"
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin users by UID"
    }
  }
}
